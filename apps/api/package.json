{
  "name": "@busqueda-tesoro/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply busqueda-tesoro-db --local",
    "db:seed:local": "wrangler d1 execute busqueda-tesoro-db --local --file=../../seed/demo.sql",
    "db:reset:local": "node ../../scripts/db-reset-local.mjs"
  },
  "dependencies": {
    "@busqueda-tesoro/shared": "*",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^22.20.3",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0",
    "wrangler": "^3.78.0"
  }
}
